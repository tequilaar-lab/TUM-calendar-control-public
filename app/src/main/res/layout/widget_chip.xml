<!-- Aufgabe: Terminblock des großen Widgets: Punkt, Zeit und Kurs, optional Raum; reine Darstellungsressource ohne Daten oder Aktionen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/chip_root" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/widget_chip_bg" android:paddingStart="6dp" android:paddingEnd="6dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/chip_dot" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="5dp" android:importantForAccessibility="no" android:src="@drawable/widget_dot_must" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/chip_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/chip_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
