<!-- Aufgabe: Tageszeile des großen Widgets: Wochentag/Datum, Terminblöcke, Rest; reine Darstellungsressource ohne Daten oder Aktionen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/day_root" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="22dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/day_label" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="11sp" android:lineSpacingMultiplier="0.9" android:textColor="@color/widget_muted" android:maxLines="2" />
    <LinearLayout android:id="@+id/day_chips" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:paddingTop="2dp" android:paddingBottom="2dp" android:orientation="horizontal" />
    <TextView android:id="@+id/day_more" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textSize="11sp" android:textColor="@color/widget_muted" android:visibility="gone" />
</LinearLayout>
